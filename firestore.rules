rules_version = '2';

// =====================================================================
//  LUẬT BẢO MẬT FIRESTORE — Quản lý Dòng tiền
// ---------------------------------------------------------------------
//  1. Danh sách trắng: chỉ Gmail có trong /members và active == true
//     mới đọc/ghi được dữ liệu. Người lạ có link cũng không thấy gì.
//  2. Vai trò:
//       OWNER    : toàn quyền + quản lý thành viên + xem nhật ký
//       CO_OWNER : toàn quyền dòng tiền, duyệt chi, quản lý thành viên
//                  (trừ tài khoản OWNER), xem nhật ký
//       STAFF    : CHỈ công nợ phải thu / phải trả (thêm, sửa, xóa), danh bạ NCC,
//                  ghi "đã chuyển tiền" cho lệnh chi đã duyệt
//  3. Nhật ký bắt buộc: mọi thay đổi số liệu phải kèm 1 dòng
//     audit_logs tạo CÙNG LÚC, đúng tài liệu, đúng hành động, đúng
//     người. Nhật ký không ai sửa / xóa được. Các thao tác hàng loạt
//     (duyệt nhiều chứng từ, kết chuyển, hủy kết chuyển) dùng 1 dòng
//     nhật ký 'BATCH' liệt kê toàn bộ đường dẫn tài liệu bị ghi.
//  4. Chứng từ thu chi nội bộ: mọi vai trò lập được; STAFF chỉ thấy
//     chứng từ của mình; chỉ OWNER / CO_OWNER duyệt, từ chối, kết
//     chuyển; chỉ OWNER hủy kết chuyển (đảo bút toán). Bút toán sổ quỹ
//     sinh từ chứng từ bị khóa, không sửa / xóa trực tiếp được.
//  5. Mặc định: TỪ CHỐI mọi đường dẫn không khai báo bên dưới.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- Danh tính & vai trò ----------------
    function ownerEmail() {
      return 'waaseevn@gmail.com';
    }
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(myEmail());
    }
    function isMember() {
      return signedIn() && exists(memberPath()) && get(memberPath()).data.active == true;
    }
    function myRole() {
      return get(memberPath()).data.role;
    }
    function isOwner() {
      return isMember() && myRole() == 'OWNER';
    }
    function isManager() {
      return isMember() && myRole() in ['OWNER', 'CO_OWNER'];
    }
    function isStaffOrAbove() {
      return isMember() && myRole() in ['OWNER', 'CO_OWNER', 'STAFF'];
    }

    // ---------------- Nhật ký bắt buộc ----------------
    function logPath(id) {
      return /databases/$(database)/documents/audit_logs/$(id);
    }
    function logAfter(id) {
      return getAfter(logPath(id)).data;
    }
    // Thêm / sửa: tài liệu mang _auditId trỏ tới 1 dòng nhật ký MỚI tạo trong cùng lô ghi.
    // Nhật ký 'BATCH' (giao dịch hàng loạt) hợp lệ cho mọi đường dẫn có trong docPaths.
    function audited(path, action) {
      let aid = request.resource.data._auditId;
      return aid is string
        && !exists(logPath(aid))
        && logAfter(aid).actorEmail == myEmail()
        && (
          (logAfter(aid).docPath == path && logAfter(aid).action == action)
          || (logAfter(aid).action == 'BATCH' && path in logAfter(aid).docPaths)
        );
    }
    // Xóa: mã nhật ký cố định = DEL_<collection>_<id>_<_auditId hiện tại>
    function auditedDelete(coll, id) {
      let aid = 'DEL_' + coll + '_' + id + '_' + resource.data.get('_auditId', 'none');
      return !exists(logPath(aid))
        && logAfter(aid).docPath == coll + '/' + id
        && logAfter(aid).action == 'DELETE'
        && logAfter(aid).actorEmail == myEmail();
    }

    // ---------------- Kiểm tra dữ liệu ----------------
    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function isDateOrEmpty(v) {
      return v == '' || isDate(v);
    }
    function nonNeg(v) {
      return (v is int || v is float) && v >= 0;
    }
    function pos(v) {
      return (v is int || v is float) && v > 0;
    }
    function shortText(v, max) {
      return v is string && v.size() <= max;
    }
    function createdByMe() {
      return request.resource.data.createdBy == myEmail();
    }
    function keepsCreator() {
      return request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');
    }

    function validCash(d) {
      return d.type in ['IN', 'OUT']
        && pos(d.amount)
        && isDate(d.date)
        && shortText(d.description, 500) && d.description.size() > 0
        && shortText(d.get('counterparty', ''), 300)
        && shortText(d.get('note', ''), 2000);
    }
    function validBank(d) {
      return shortText(d.name, 200) && d.name.size() > 0
        && nonNeg(d.creditLimit)
        && nonNeg(d.depositBalance);
    }
    function validLoan(d) {
      return d.bankId is string
        && shortText(d.get('contractNo', ''), 100)
        && pos(d.amount)
        && isDate(d.disbursedDate)
        && isDate(d.maturityDate)
        && nonNeg(d.interestRate) && d.interestRate <= 100
        && d.status in ['ACTIVE', 'SETTLED'];
    }
    function validDebt(d) {
      return shortText(d.partnerName, 300) && d.partnerName.size() > 0
        && nonNeg(d.total)
        && nonNeg(d.paid)
        && d.paid <= d.total
        && isDateOrEmpty(d.get('dueDate', ''));
    }
    function validReceivable(d) {
      return validDebt(d) && d.certainty in ['SURE', 'MAYBE_LATE', 'DOUBTFUL'];
    }
    function validPayable(d) {
      return validDebt(d) && d.priority in ['P1', 'P2', 'P3'];
    }
    function validPayment(d) {
      return d.kind in ['AR', 'AP']
        && d.parentId is string
        && pos(d.amount)
        && isDate(d.date)
        && d.method in ['CASH', 'BANK', 'OTHER']
        && (
          (d.kind == 'AR' && existsAfter(/databases/$(database)/documents/receivables/$(d.parentId)))
          || (d.kind == 'AP' && existsAfter(/databases/$(database)/documents/payables/$(d.parentId)))
        );
    }
    function validPartner(d) {
      return shortText(d.name, 300) && d.name.size() > 0;
    }
    function validApproval(d) {
      return d.payableId is string
        && d.mode in ['FULL', 'PART']
        && nonNeg(d.amount)
        && d.status in ['OPEN', 'DONE', 'CANCELLED'];
    }
    // Kế toán chỉ được chuyển lệnh chi từ "chờ chuyển" sang "đã chuyển tiền"
    function staffExecutes() {
      return resource.data.status == 'OPEN'
        && request.resource.data.status == 'DONE'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'paidAmount', 'paidOn', 'paymentId', 'updatedBy', 'updatedAt', '_auditId']);
    }
    // ---------------- Chứng từ thu chi nội bộ ----------------
    function voucherPath(id) {
      return /databases/$(database)/documents/internal_vouchers/$(id);
    }
    function batchPath(id) {
      return /databases/$(database)/documents/posting_batches/$(id);
    }
    function validVoucher(d) {
      return d.type in ['TU', 'TT', 'PT', 'PC']
        && d.status in ['DRAFT', 'PENDING', 'APPROVED', 'POSTED', 'REJECTED', 'CANCELLED']
        && d.auto is bool
        && d.requestedBy is string
        && shortText(d.no, 40)
        && isDate(d.date)
        && shortText(d.person, 200) && d.person.size() > 0
        && shortText(d.reason, 1000) && d.reason.size() > 0
        && nonNeg(d.amount)
        && shortText(d.get('postingBatchId', ''), 100)
        && (d.type != 'TT' || (d.items is list && d.items.size() > 0 && d.items.size() <= 100 && nonNeg(d.advanceAmount)))
        && d.get('attachments', []) is list && d.get('attachments', []).size() <= 12
        && nonNeg(d.get('approvedAmount', 0))
        && shortText(d.get('approvalNote', ''), 500);
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Trường do hệ thống quản lý: người lập không sửa được
    function systemKeys() {
      return ['auto', 'requestedBy', 'createdBy', 'postingBatchId', 'postedOn', 'postedBy', 'entries', 'cashEntryIds', 'generatedIds', 'settledAmount'];
    }

    // Công nợ gốc của một lần thanh toán không còn (bị xóa trong cùng lô hoặc trước đó)
    function debtGone(d) {
      return (d.kind == 'AR' && !existsAfter(/databases/$(database)/documents/receivables/$(d.parentId)))
        || (d.kind == 'AP' && !existsAfter(/databases/$(database)/documents/payables/$(d.parentId)));
    }

    function validMember(email) {
      let d = request.resource.data;
      return d.email == email
        && d.role in ['CO_OWNER', 'STAFF']
        && d.active is bool;
    }

    // =================================================================
    //  THÀNH VIÊN (danh sách trắng)
    // =================================================================
    match /members/{email} {
      allow get: if (signedIn() && email == myEmail()) || isMember();
      allow list: if isMember();
      // Khởi tạo lần đầu: chỉ đúng Gmail Chủ doanh nghiệp tự tạo hồ sơ OWNER của mình
      allow create: if signedIn()
        && email == myEmail()
        && email == ownerEmail()
        && request.resource.data.email == email
        && request.resource.data.role == 'OWNER'
        && request.resource.data.active == true;
      // Chủ DN / Đồng quản trị cấp quyền cho người khác (không thể tạo thêm OWNER)
      allow create: if isManager()
        && email == email.lower()
        && email != myEmail()
        && validMember(email)
        && createdByMe()
        && audited('members/' + email, 'CREATE');
      // Mỗi người tự cập nhật tên / ảnh / lần truy cập của mình (không đổi được vai trò)
      allow update: if signedIn()
        && email == myEmail()
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastSeenAt']);
      // Không ai sửa / khóa / xóa được tài khoản OWNER qua ứng dụng
      allow update: if isManager()
        && email != myEmail()
        && resource.data.role != 'OWNER'
        && validMember(email)
        && audited('members/' + email, 'UPDATE');
      allow delete: if isManager()
        && email != myEmail()
        && resource.data.role != 'OWNER'
        && auditedDelete('members', email);
    }

    // =================================================================
    //  TIỀN MẶT, NGÂN HÀNG, KHẾ ƯỚC VAY — chỉ OWNER / CO_OWNER
    // =================================================================
    // Bút toán sinh từ chứng từ (có voucherId) bị khóa: chỉ sửa sai bằng Hủy kết chuyển (bút toán đảo)
    match /cash_entries/{id} {
      allow read: if isManager();
      allow create: if isManager() && validCash(request.resource.data) && createdByMe()
        && audited('cash_entries/' + id, 'CREATE');
      allow update: if isManager() && validCash(request.resource.data) && keepsCreator()
        && resource.data.get('voucherId', '') == ''
        && request.resource.data.get('voucherId', '') == ''
        && audited('cash_entries/' + id, 'UPDATE');
      allow delete: if isManager() && resource.data.get('voucherId', '') == ''
        && auditedDelete('cash_entries', id);
    }

    match /banks/{id} {
      allow read: if isManager();
      allow create: if isManager() && validBank(request.resource.data) && createdByMe()
        && audited('banks/' + id, 'CREATE');
      allow update: if isManager() && validBank(request.resource.data) && keepsCreator()
        && audited('banks/' + id, 'UPDATE');
      allow delete: if isManager() && auditedDelete('banks', id);
    }

    match /loans/{id} {
      allow read: if isManager();
      allow create: if isManager() && validLoan(request.resource.data) && createdByMe()
        && audited('loans/' + id, 'CREATE');
      allow update: if isManager() && validLoan(request.resource.data) && keepsCreator()
        && audited('loans/' + id, 'UPDATE');
      allow delete: if isManager() && auditedDelete('loans', id);
    }

    // =================================================================
    //  CÔNG NỢ & DANH BẠ NCC — STAFF xem & nhập, chỉ OWNER / CO_OWNER xóa
    // =================================================================
    match /receivables/{id} {
      allow read: if isStaffOrAbove();
      allow create: if isStaffOrAbove() && validReceivable(request.resource.data) && createdByMe()
        && audited('receivables/' + id, 'CREATE');
      allow update: if isStaffOrAbove() && validReceivable(request.resource.data) && keepsCreator()
        && audited('receivables/' + id, 'UPDATE');
      allow delete: if isStaffOrAbove() && auditedDelete('receivables', id);
    }

    match /payables/{id} {
      allow read: if isStaffOrAbove();
      allow create: if isStaffOrAbove() && validPayable(request.resource.data) && createdByMe()
        && audited('payables/' + id, 'CREATE');
      allow update: if isStaffOrAbove() && validPayable(request.resource.data) && keepsCreator()
        && audited('payables/' + id, 'UPDATE');
      allow delete: if isStaffOrAbove() && auditedDelete('payables', id);
    }

    // Lịch sử thanh toán từng đợt: không sửa, chỉ thêm / xóa.
    // Xóa lẻ: OWNER / CO_OWNER. Kế toán chỉ xóa được khi công nợ gốc bị xóa cùng lúc (hoặc đã xóa trước).
    match /payments/{id} {
      allow read: if isStaffOrAbove();
      allow create: if isStaffOrAbove() && validPayment(request.resource.data) && createdByMe()
        && audited('payments/' + id, 'CREATE');
      allow update: if false;
      allow delete: if (isManager() || (isStaffOrAbove() && debtGone(resource.data)))
        && auditedDelete('payments', id);
    }

    match /partners/{id} {
      allow read: if isStaffOrAbove();
      allow create: if isStaffOrAbove() && validPartner(request.resource.data) && createdByMe()
        && audited('partners/' + id, 'CREATE');
      allow update: if isStaffOrAbove() && validPartner(request.resource.data) && keepsCreator()
        && audited('partners/' + id, 'UPDATE');
      allow delete: if isManager() && auditedDelete('partners', id);
    }

    // Lệnh duyệt chi: OWNER / CO_OWNER duyệt, sửa, hủy; STAFF chỉ ghi "đã chuyển tiền"
    match /approvals/{id} {
      allow read: if isStaffOrAbove();
      allow create: if isManager() && validApproval(request.resource.data) && createdByMe()
        && audited('approvals/' + id, 'CREATE');
      allow update: if isManager() && validApproval(request.resource.data) && keepsCreator()
        && audited('approvals/' + id, 'UPDATE');
      allow update: if isStaffOrAbove() && staffExecutes() && validApproval(request.resource.data) && keepsCreator()
        && audited('approvals/' + id, 'UPDATE');
      allow delete: if false;
    }

    // =================================================================
    //  CHỨNG TỪ THU CHI NỘI BỘ (TT 200): GĐNTU, GĐNTT, Phiếu thu, Phiếu chi
    // =================================================================
    match /internal_vouchers/{id} {
      allow read: if isManager() || (isStaffOrAbove() && resource.data.requestedBy == myEmail());

      // Lập mới: mọi vai trò (Nháp / Chờ duyệt). Quản lý được lập & duyệt luôn (đã cấp số).
      allow create: if isStaffOrAbove() && createdByMe()
        && request.resource.data.auto == false
        && request.resource.data.requestedBy == myEmail()
        && request.resource.data.postingBatchId == ''
        && (
          (request.resource.data.status in ['DRAFT', 'PENDING'] && request.resource.data.no == '')
          || (isManager() && request.resource.data.status == 'APPROVED'
              && request.resource.data.approvedBy == myEmail()
              && request.resource.data.no.size() > 0)
        )
        && validVoucher(request.resource.data)
        && audited('internal_vouchers/' + id, 'CREATE');

      // Phiếu thu / phiếu chi sinh tự động trong đợt kết chuyển
      allow create: if isManager() && createdByMe()
        && request.resource.data.auto == true
        && request.resource.data.status == 'POSTED'
        && request.resource.data.no.size() > 0
        && existsAfter(batchPath(request.resource.data.postingBatchId))
        && validVoucher(request.resource.data)
        && audited('internal_vouchers/' + id, 'CREATE');

      // Soạn / sửa / gửi duyệt (người lập hoặc quản lý) — quản lý có thể duyệt ngay khi lưu.
      // Duyệt một phần: approvedAmount (0 = duyệt toàn bộ) không vượt số đề nghị; người lập không tự ghi được.
      allow update: if isStaffOrAbove()
        && (resource.data.requestedBy == myEmail() || isManager())
        && resource.data.auto == false
        && resource.data.status in ['DRAFT', 'PENDING', 'REJECTED']
        && !changed().hasAny(systemKeys())
        && (
          (request.resource.data.status in ['DRAFT', 'PENDING']
            && request.resource.data.no == resource.data.no
            && !changed().hasAny(['approvedBy', 'approvedOn', 'approvedAmount', 'approvalNote']))
          || (isManager() && request.resource.data.status == 'APPROVED'
            && request.resource.data.approvedBy == myEmail()
            && request.resource.data.no.size() > 0
            && (resource.data.no == '' || request.resource.data.no == resource.data.no)
            && request.resource.data.get('approvedAmount', 0) <= request.resource.data.amount)
        )
        && validVoucher(request.resource.data)
        && audited('internal_vouchers/' + id, 'UPDATE');

      // Từ chối (có lý do) hoặc hủy duyệt khi chưa kết chuyển — giữ nguyên số đã cấp
      allow update: if isManager()
        && resource.data.auto == false
        && resource.data.status in ['PENDING', 'APPROVED']
        && request.resource.data.status in ['REJECTED', 'PENDING']
        && (request.resource.data.status == 'PENDING' || request.resource.data.rejectReason.size() > 0)
        && request.resource.data.no == resource.data.no
        && changed().hasOnly(['status', 'rejectReason', 'rejectedBy', 'rejectedOn', 'approvedBy', 'approvedByName', 'approvedOn', 'approvedAmount', 'approvalNote', 'updatedBy', 'updatedAt', '_auditId'])
        && validVoucher(request.resource.data)
        && audited('internal_vouchers/' + id, 'UPDATE');

      // Kết chuyển: Đã duyệt -> Đã kết chuyển (một lần duy nhất, gắn với đợt kết chuyển tạo cùng lúc)
      allow update: if isManager()
        && resource.data.auto == false
        && resource.data.status == 'APPROVED'
        && request.resource.data.status == 'POSTED'
        && request.resource.data.no.size() > 0
        && (resource.data.no == '' || request.resource.data.no == resource.data.no)
        && existsAfter(batchPath(request.resource.data.postingBatchId))
        && changed().hasOnly(['status', 'no', 'postingBatchId', 'postedOn', 'postedBy', 'entries', 'cashEntryIds', 'generatedIds', 'total', 'settledAmount', 'period', 'updatedBy', 'updatedAt', '_auditId'])
        && validVoucher(request.resource.data)
        && audited('internal_vouchers/' + id, 'UPDATE');

      // Quyết toán tạm ứng: chỉ thay đổi số đã quyết toán của giấy tạm ứng đã kết chuyển
      allow update: if isManager()
        && resource.data.type == 'TU'
        && resource.data.status == 'POSTED'
        && request.resource.data.status == 'POSTED'
        && changed().hasOnly(['settledAmount', 'updatedBy', 'updatedAt', '_auditId'])
        && nonNeg(request.resource.data.settledAmount)
        && request.resource.data.settledAmount <= resource.data.amount
        && audited('internal_vouchers/' + id, 'UPDATE');

      // Hủy kết chuyển / đảo bút toán: chỉ Chủ doanh nghiệp
      allow update: if isOwner()
        && resource.data.status == 'POSTED'
        && (
          (resource.data.auto == false
            && request.resource.data.status == 'APPROVED'
            && (resource.data.type != 'TU' || resource.data.get('settledAmount', 0) == 0)
            && changed().hasOnly(['status', 'postingBatchId', 'postedOn', 'postedBy', 'cashEntryIds', 'generatedIds', 'entries', 'reversedCount', 'lastReversal', 'updatedBy', 'updatedAt', '_auditId']))
          || (resource.data.auto == true
            && request.resource.data.status == 'CANCELLED'
            && changed().hasOnly(['status', 'cancelledOn', 'cancelReason', 'updatedBy', 'updatedAt', '_auditId']))
        )
        && audited('internal_vouchers/' + id, 'UPDATE');

      // Xóa: chỉ chứng từ chưa được cấp số (chưa từng duyệt)
      allow delete: if isStaffOrAbove()
        && (resource.data.requestedBy == myEmail() || isManager())
        && resource.data.auto == false
        && resource.data.status in ['DRAFT', 'PENDING', 'REJECTED']
        && resource.data.no == ''
        && auditedDelete('internal_vouchers', id);
    }

    // Ảnh / file đính kèm chứng từ (nén, lưu trực tiếp trong Firestore)
    match /voucher_files/{id} {
      allow read: if isManager()
        || (isStaffOrAbove() && (resource.data.createdBy == myEmail() || resource.data.requestedBy == myEmail()));
      allow create: if isStaffOrAbove() && createdByMe()
        && request.resource.data.voucherId is string
        && request.resource.data.requestedBy is string
        && shortText(request.resource.data.name, 200)
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 1000000;
      allow update: if false;
      allow delete: if isStaffOrAbove()
        && (resource.data.createdBy == myEmail() || resource.data.requestedBy == myEmail() || isManager())
        && (!exists(voucherPath(resource.data.voucherId))
            || get(voucherPath(resource.data.voucherId)).data.status in ['DRAFT', 'PENDING', 'REJECTED']);
    }

    // Đợt kết chuyển: bất biến, chỉ Chủ DN ghi nhận chứng từ bị hủy kết chuyển
    match /posting_batches/{id} {
      allow read: if isManager();
      allow create: if isManager() && createdByMe()
        && request.resource.data.code is string
        && request.resource.data.voucherIds is list
        && audited('posting_batches/' + id, 'CREATE');
      allow update: if isOwner()
        && changed().hasOnly(['reversedIds', 'reversedCount', 'status', 'updatedBy', 'updatedAt', '_auditId'])
        && audited('posting_batches/' + id, 'UPDATE');
      allow delete: if false;
    }

    // Bộ đếm số chứng từ / số đợt: chỉ tăng, không giảm, không xóa
    match /counters/{key} {
      allow read: if isManager();
      allow create: if isManager() && request.resource.data.value is int && request.resource.data.value >= 1;
      allow update: if isManager() && request.resource.data.value is int && request.resource.data.value > resource.data.value;
      allow delete: if false;
    }

    // =================================================================
    //  ĐIỀU PHỐI THÁNG — chỉ OWNER / CO_OWNER
    // =================================================================
    // Bản nháp làm việc (tự lưu liên tục, không cần nhật ký từng phím gõ)
    match /plans/{month} {
      allow read, write: if isManager();
    }
    // Bản chốt: bất biến (không sửa), chỉ OWNER được xóa
    match /plan_snapshots/{id} {
      allow read: if isManager();
      allow create: if isManager() && createdByMe() && request.resource.data.month is string
        && audited('plan_snapshots/' + id, 'CREATE');
      allow update: if false;
      allow delete: if isOwner() && auditedDelete('plan_snapshots', id);
    }
    // Cài đặt: tên doanh nghiệp (mọi thành viên đọc, Chủ DN sửa); mẫu chi cố định (OWNER / CO_OWNER)
    match /settings/{key} {
      allow read: if (key == 'company' && isMember()) || isManager();
      allow write: if isManager();
    }

    // =================================================================
    //  NHẬT KÝ THAO TÁC — chỉ thêm, không ai sửa / xóa được
    // =================================================================
    match /audit_logs/{logId} {
      allow read: if isManager();
      allow create: if isMember()
        && request.resource.data.actorEmail == myEmail()
        && request.resource.data.at == request.time
        && request.resource.data.action in ['CREATE', 'UPDATE', 'DELETE', 'BATCH']
        && request.resource.data.docPath is string
        && (request.resource.data.action != 'BATCH' || request.resource.data.docPaths is list);
      allow update, delete: if false;
    }
    // Nhật ký cũ chuyển từ bản claude.ai: chỉ Chủ DN đọc / nhập, không sửa / xóa
    match /audit_archive/{logId} {
      allow read: if isManager();
      allow create: if isOwner();
      allow update, delete: if false;
    }
  }
}
